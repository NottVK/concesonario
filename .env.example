# Base de datos (PostgreSQL 16 + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_USER=concesionario
DB_PASSWORD=cambia_esta_clave
DB_NAME=concesionario

# API
PORT=8000
# Secreto del JWT: mínimo 16 caracteres, aleatorio (p. ej. openssl rand -hex 32)
JWT_SECRET=cambia_este_secreto_por_uno_largo
# Expiración corta del token de acceso
JWT_EXPIRES_IN=1h
# Peticiones por minuto y por IP (límite global)
THROTTLE_LIMIT=100
# Tasa efectiva anual por defecto del simulador de crédito (0.18 = 18 %)
FINANCING_DEFAULT_RATE_EA=0.18
FRONTEND_URL=http://localhost:5173

# Chatbot: proveedor del modelo de chat = ollama (local o de un compañero), groq (externo) o mock (pruebas)
CHAT_PROVIDER=ollama
# Groq: servicio EXTERNO (el texto de la persona sale de tu máquina; el widget lo avisa). Solo para evaluar un modelo real
# cuando no hay uno local. La clave va ÚNICAMENTE aquí, en tu .env (que nunca se sube a git): no la pegues en comandos,
# capturas, issues ni mensajes. Se crea en https://console.groq.com/keys (el plan gratuito limita por minuto).
GROQ_API_KEY=pon_aqui_tu_clave_de_groq
GROQ_MODEL=llama-3.3-70b-versatile
# Ollama: en esta máquina (contenedor `ollama` de Docker, puerto 11434) o en la de un compañero (ver docs/GUIA-IA-COMPANEROS.md)
OLLAMA_HOST=http://localhost:11434
# gpt-oss:20b (OpenAI, Apache 2.0): razona antes de contestar, ~16 GB de memoria (GPU + RAM). Decisión 124.
OLLAMA_MODEL=gpt-oss:20b
# Contexto: prompt + tools + 10 turnos de historial + resultados de tools. 8192 es el mínimo recomendado con gpt-oss
OLLAMA_NUM_CTX=8192
# Cuánto queda cargado el modelo tras la última petición (cargarlo en frío tarda ~45 s)
OLLAMA_KEEP_ALIVE=30m
# Razonamiento de gpt-oss: low (más rápido, el del bot), medium o high. Vacío = no se envía (obligatorio vacío con qwen u otros que no piensan)
OLLAMA_THINK=low
# Plazo por llamada al modelo (10000 a 300000 ms) y tope del turno completo del chat (30000 a 300000 ms)
OLLAMA_TIMEOUT_MS=180000
CHAT_TURN_TIMEOUT_MS=240000
# Búsqueda semántica: modelo de embeddings (ollama pull nomic-embed-text) y su proveedor (ollama o mock)
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
# Prefijos de tarea search_query:/search_document: (en la medición acertaron más SIN ellos)
OLLAMA_EMBED_PREFIXES=false
# Piso de similitud coseno (0 a 1) para GET /api/vehiculos/buscar
SEARCH_MIN_SIMILARITY=0.40

# Seeds: contraseña de los usuarios demo (admin y vendedor)
SEED_DEMO_PASSWORD=cambia_esta_clave_demo

# SOLO para correr la evaluación de las 20 preguntas (chatbot/eval): relaja los límites por IP y añade `debug` a las
# respuestas del chat. Se ignora con NODE_ENV=production. No lo dejes puesto en un servidor real.
# CHAT_EVAL_MODE=true
# CHAT_LIMIT_PER_MINUTE=1000
# CHAT_LIMIT_PER_HOUR=100000

# Servidor MCP (Fase 5): la API NO arranca sin estos dos secretos. Genera cada uno con `openssl rand -hex 32`.
# Pepper del HMAC con el que se guardan las keys de los bots (mínimo 32 caracteres)
MCP_KEY_PEPPER=cambia_esto_por_un_secreto_aleatorio_de_32_o_mas_caracteres
# Clave AES-256 (64 caracteres hexadecimales) que cifra las keys que AutoMax envía a otros bots
BOT_KEY_ENCRYPTION_KEY=cambia_esto_por_64_caracteres_hexadecimales
# Rotación del pepper (opcional): sube la versión y deja el pepper viejo aquí hasta migrar a todos los bots
# MCP_KEY_PEPPER_VERSION=2
# MCP_KEY_PEPPER_PREVIOUS=

# A2A (Fase 6): URL pública del bot, la que sale en la tarjeta /.well-known/agent.json (nunca se toma de la cabecera Host).
# En desarrollo es opcional (por defecto http://localhost:PORT); en producción es obligatoria y con https.
# Su host se acepta además en la cabecera Host de /a2a/tasks.
# A2A_PUBLIC_BASE_URL=http://localhost:8000

# A2A saliente (Fase 6) — SOLO DESARROLLO. Permite que AutoMax llame a bots de esta máquina o de la LAN, que de otro modo
# se bloquean (protección SSRF). Cada entrada es una IP literal con su puerto EXACTO, separadas por coma (máximo 10); solo ahí
# se acepta http. La API NO arranca con esta variable si NODE_ENV=production. No admite nombres, rangos ni comodines, y los
# puertos de la propia API, la base de datos y Ollama están siempre prohibidos.
# A2A_DEV_ALLOWED_TARGETS=127.0.0.1:8100,127.0.0.1:8101

