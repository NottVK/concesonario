# Base de datos (PostgreSQL 16 + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_USER=concesionario
DB_PASSWORD=cambia_esta_clave
DB_NAME=concesionario

# API
PORT=8000
# Secreto del JWT: mínimo 16 caracteres, aleatorio (p. ej. openssl rand -hex 32)
JWT_SECRET=cambia_este_secreto_por_uno_largo
# Expiración corta del token de acceso
JWT_EXPIRES_IN=1h
# Peticiones por minuto y por IP (límite global)
THROTTLE_LIMIT=100
# Tasa efectiva anual por defecto del simulador de crédito (0.18 = 18 %)
FINANCING_DEFAULT_RATE_EA=0.18
FRONTEND_URL=http://localhost:5173

# Chatbot: proveedor del modelo de chat = ollama (local o de un compañero), groq (externo) o mock (pruebas)
CHAT_PROVIDER=ollama
# Ollama: en esta máquina o en la de un compañero (ver docs/GUIA-IA-COMPANEROS.md)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=5m
# Búsqueda semántica: modelo de embeddings (ollama pull nomic-embed-text) y su proveedor (ollama o mock)
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
# Prefijos de tarea search_query:/search_document: (en la medición acertaron más SIN ellos)
OLLAMA_EMBED_PREFIXES=false
# Piso de similitud coseno (0 a 1) para GET /api/vehiculos/buscar
SEARCH_MIN_SIMILARITY=0.40

# Seeds: contraseña de los usuarios demo (admin y vendedor)
SEED_DEMO_PASSWORD=cambia_esta_clave_demo
