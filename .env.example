# Base de datos (PostgreSQL 16 + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_USER=concesionario
DB_PASSWORD=cambia_esta_clave
DB_NAME=concesionario

# API
PORT=8000
# Secreto del JWT: mínimo 16 caracteres, aleatorio (p. ej. openssl rand -hex 32)
JWT_SECRET=cambia_este_secreto_por_uno_largo
# Expiración corta del token de acceso
JWT_EXPIRES_IN=1h
# Peticiones por minuto y por IP (límite global)
THROTTLE_LIMIT=100
# Tasa efectiva anual por defecto del simulador de crédito (0.18 = 18 %)
FINANCING_DEFAULT_RATE_EA=0.18
FRONTEND_URL=http://localhost:5173

# Chatbot local
OLLAMA_HOST=http://localhost:11434

# Seeds: contraseña de los usuarios demo (admin y vendedor)
SEED_DEMO_PASSWORD=cambia_esta_clave_demo
